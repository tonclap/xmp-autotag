# Copy to .env and fill in. .env is git-ignored.

# --- Archive ---------------------------------------------------------------
# The photo archive to tag and search (required).
PHOTO_ROOT=D:\Photos
# PHOTO_ROOT=/home/you/Photos

# Optional second collection with different content (infographics, memes,
# reference images), tagged with a prompt suited to it. Only the listed
# subfolders are walked.
# MEDIA_ROOT=D:\Media
# MEDIA_ROOT=/home/you/Media
# MEDIA_SUBDIRS=Infographics,Humour,Reference

# Where run logs, sidecar backups, the search index and thumbnails go.
# (Namespaced so a generic OUTPUT_DIR already set on your machine cannot
# silently redirect them.)
# XMP_AUTOTAG_OUTPUT_DIR=output

# --- Vision model (needed for tagging only) --------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Language of the generated descriptions and keywords, written as you would say
# it to a person: English, German, Brazilian Portuguese.
TAG_LANGUAGE=English
# Parallel requests.
XMP_AUTOTAG_WORKERS=8

# --- Semantic search (needed for indexing and searching only) --------------
# Directory holding model_quantized.onnx and tokenizer.json. Nothing is
# downloaded automatically - see README, "Semantic search".
EMBEDDING_MODEL_DIR=models/embedding
WEB_SEARCH_PORT=8766
# Optional JSON file with your own place-name aliases:
#   {"austria": ["osterreich"], "vienna": ["wien"]}
# GEO_ALIASES_FILE=geo_aliases.json
